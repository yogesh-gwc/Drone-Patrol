# ---------------------------------------------------------------------------
# AEROGUARD 3D - frontend environment template
#
# Copy this file to `.env` and fill in the values for your machine.
# `.env` is git-ignored. Never put a real key in this template.
#
# Only VITE_* variables are exposed to the browser by Vite. Never place
# database credentials or backend secrets in this file - anything here ships
# to the client.
# ---------------------------------------------------------------------------

# Base URL of the AEROGUARD 3D backend REST API.
VITE_API_URL=http://localhost:4000

# Base URL of the AEROGUARD 3D Socket.IO server.
# Leave unset to reuse VITE_API_URL.
VITE_SOCKET_URL=http://localhost:4000

# --- Map provider -----------------------------------------------------------
# MapTiler API key. REQUIRED: without it the map, the vector basemap and the
# 3D terrain source cannot load, and the app shows a configuration error.
#
# Create a free key at https://cloud.maptiler.com/account/keys/
# The key is used for both the map style and the Terrain RGB elevation tiles.
VITE_MAPTILER_API_KEY=

# Optional MapTiler style id. Defaults to `streets-v2-dark`, which gives the
# dark command-centre basemap with a full road hierarchy and readable labels.
# Other dark options: dataviz-dark, basic-v2-dark, toner-v2.
VITE_MAP_STYLE=streets-v2-dark
