# Dependencies
node_modules/
.pnp/
.pnp.js

# Build output
dist/
build/
*.tsbuildinfo

# Environment files - never commit real credentials
.env
.env.local
.env.*.local
!.env.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Test / coverage output
coverage/
playwright-report/
test-results/

# Editor and OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# Large local map exports and 3D assets are pulled in per phase, not committed
map-data/**/*.pbf
map-data/**/*.osm
map-data/**/*.mbtiles

# Runtime output, not configuration.
#
# The engine APPENDS every E-Challan it issues to this file and reads it back
# on boot. Committing it made every developer's local runs collide - it caused
# a merge conflict the first time two branches were merged - and it grows
# without bound. The engine already treats a missing file as an empty log, so
# a fresh clone simply starts its own.
backend/data/speedViolations.json
