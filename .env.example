# ---------------------------------------------------------------------------
# Zero Accident Prevention - deployment environment
#
#   cp .env.example .env   &&   fill in the values below
#
# This is the ONLY env file used when the stack runs in Docker. Both services
# read their configuration from here through docker-compose.yml's `environment:`
# and `build.args` blocks - there are no per-service .env files in a deployed
# run. (frontend/.env still exists for local `npm run dev` and is ignored by
# Docker.)
#
# In CI this file is not committed: .github/workflows/deploy.yml writes it on
# the runner from the repository's Actions **variables** and **secrets** before
# building. Keep the two in step - a name added here must be added there too,
# or the deployed value silently falls back to the default below.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Public addressing
#
# PUBLIC_HOST is the DNS suffix Traefik routes on. The stack claims two names
# beneath it:
#
#   zero-accident.<PUBLIC_HOST>       the operator UI
#   zero-accident-api.<PUBLIC_HOST>   the REST + Socket.IO backend
#
# Both must resolve to the Traefik host before a deploy is useful.
# ---------------------------------------------------------------------------
PUBLIC_HOST=internal.gwcdata.ai

# http or https - the scheme the BROWSER uses.
#
# This is not cosmetic. The operator UI talks to the backend directly from the
# browser (REST + a Socket.IO websocket), so the two must share a scheme: an
# https page calling an http API is blocked as mixed content and the map loads
# with a dead telemetry feed and no error the operator can act on. Flip this to
# http only if Traefik is serving this stack without TLS.
PUBLIC_SCHEME=https

# ---------------------------------------------------------------------------
# Backend
# ---------------------------------------------------------------------------
# Port the backend listens on inside its container. Traefik routes to it; it is
# not published on the host.
BACKEND_PORT=4000

# ---------------------------------------------------------------------------
# Map provider
#
# REQUIRED. Without it the basemap, the 3D terrain source and the corridor view
# all fail, and the UI shows a configuration error instead of the highway.
#
# Free key: https://cloud.maptiler.com/account/keys/
#
# NOTE: this value is compiled into the browser bundle at image build time, as
# every VITE_* value is. It is a public, domain-restrictable client key - not a
# server secret - but restrict it to PUBLIC_HOST in the MapTiler console so a
# copied bundle cannot spend your quota.
# ---------------------------------------------------------------------------
VITE_MAPTILER_API_KEY=

# Optional basemap style ids. Light is the product default.
VITE_MAP_STYLE=streets-v2-light
VITE_MAP_STYLE_DARK=streets-v2-dark
