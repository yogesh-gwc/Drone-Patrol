# ---------------------------------------------------------------------------
# AEROGUARD 3D - backend environment template
#
# Copy to `.env` and adjust for your machine. `.env` is git-ignored.
#
# The prototype has NO database. Application data is static JSON in
# `backend/data/` and all simulation state is held in memory, so there are no
# credentials to configure here.
# ---------------------------------------------------------------------------

# HTTP port for the Express + Socket.IO server.
PORT=4000

# Runtime environment: development | production | test
NODE_ENV=development

# Origin of the Vite frontend, used for CORS and Socket.IO allow-listing.
CLIENT_URL=http://localhost:5173
